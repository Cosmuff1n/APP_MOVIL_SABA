# Archivo de ejemplo: copia como .env en tu PC y ajusta con los valores de TU AWS Academy.
# NO subir .env al repositorio. NUNCA guardes client secret/contraseñas en Android.
# Configuración de servidor remoto (futura API, HTTPS con / final)
API_BASE_URL=https://tu-api.ejemplo.com/

# Credenciales PÚBLICAS de aplicación (no secretos): copiar desde tu User Pool y App Client
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_TU_USER_POOL
COGNITO_CLIENT_ID=TU_APP_CLIENT_ID
COGNITO_REDIRECT_URI=com.example.appsaba://cognito/callback
COGNITO_LOGOUT_URI=com.example.appsaba://cognito/logout
COGNITO_SCOPES=email openid phone
