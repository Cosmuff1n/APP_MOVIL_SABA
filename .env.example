# Copia este archivo a .env y completa los valores reales.
# Nunca commitees .env con valores reales (ver docs/01_login.md Paso 2).
# Fuente contrato: docs/api.md

# Base URL del backend institucional (debe terminar en / para Retrofit)
API_BASE_URL=https://example1234.com/

# Cognito Hosted UI (ver cognito-auth/README.md Paso 3)
COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_ZhTULhf5B
COGNITO_CLIENT_ID=TU_APP_CLIENT_ID
COGNITO_REDIRECT_URI=com.rojas.syncpass://cognito/callback
COGNITO_LOGOUT_URI=com.rojas.syncpass://cognito/callback
COGNITO_SCOPES=email openid phone