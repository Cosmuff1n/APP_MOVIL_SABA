# Copia este archivo a .env y agrega tus propios valores Cognito.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REEMPLAZAR
COGNITO_CLIENT_ID=REEMPLAZAR_CON_APP_CLIENT_ID
COGNITO_REDIRECT_URI=com.example.appsaba://cognito/callback
COGNITO_LOGOUT_URI=com.example.appsaba://cognito/logout
COGNITO_SCOPES=openid email profile

# BFF Spring Boot en tu PC: emulador Android
BFF_API_BASE_URL=http://10.0.2.2:8080/
# Samsung real: sustituir por la IP local del PC en la misma red Wi-Fi.
# BFF_API_BASE_URL=http://192.168.X.X:8080/
