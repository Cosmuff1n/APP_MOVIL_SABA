  },
  "item": [
    {
      "name": "Parking (BFF)",
      "item": [
        {
          "name": "GET todos Parking",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bff_base_url}}/api/parking",
              "host": [
                "{{bff_base_url}}"
              ],
              "path": [
                "api",
                "parking"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
